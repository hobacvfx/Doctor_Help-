  m_Script: {fileID: 11500000, guid: 9a19a6ecd4ed2114c9ccb631dd1f32f4, type: 3}
  m_Name: NPC_90_Dialogue
  m_EditorClassIdentifier: Assembly-CSharp::DoctorHelp.NpcDialogueAsset
  content: "Evening, doctor. I'm flushed and can't get a full breath.\nMy heart keeps racing. I heard something tap the mirror from inside.\nI don't know which bothered me first. The room was quiet a moment before."
