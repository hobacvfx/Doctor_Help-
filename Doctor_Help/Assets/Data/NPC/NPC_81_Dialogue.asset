  m_Script: {fileID: 11500000, guid: 9a19a6ecd4ed2114c9ccb631dd1f32f4, type: 3}
  m_Name: NPC_81_Dialogue
  m_EditorClassIdentifier: Assembly-CSharp::DoctorHelp.NpcDialogueAsset
  content: 'Morning, doctor.

    My breath will not come easily.

    I hurt my arm when a cart knocked me over.

    The rats offered me a seat in Parliament. I’m worried about the dress code.

    Perhaps I have spent too many evenings poring over my accounts.'
