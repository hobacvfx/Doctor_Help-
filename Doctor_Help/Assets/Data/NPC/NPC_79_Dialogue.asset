  m_Name: NPC_79_Dialogue
  m_EditorClassIdentifier: Assembly-CSharp::DoctorHelp.NpcDialogueAsset
  content: "Good afternoon, doctor. I fell on the cellar steps and hurt my shoulder.\nThere were footsteps behind me, but nobody came down the stairs.\nPerhaps I turned round too quickly when I heard them."
