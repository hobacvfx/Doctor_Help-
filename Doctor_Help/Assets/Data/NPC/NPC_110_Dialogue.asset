  m_Script: {fileID: 11500000, guid: 9a19a6ecd4ed2114c9ccb631dd1f32f4, type: 3}
  m_Name: NPC_110_Dialogue
  m_EditorClassIdentifier: Assembly-CSharp::DoctorHelp.NpcDialogueAsset
  content: "Good day, doctor. I'm hot and short of breath, and my heart's racing.\nI asked a streetlamp for directions. It wouldn't wait for me to catch up.\nI've no idea why I feel this bad. I didn't have this trouble yesterday."
