  m_Script: {fileID: 11500000, guid: 9a19a6ecd4ed2114c9ccb631dd1f32f4, type: 3}
  m_Name: NPC_28_Dialogue
  m_EditorClassIdentifier: Assembly-CSharp::DoctorHelp.NpcDialogueAsset
  content: "My headache made me forget the tune I'd been practising all month.\nI'm feverish too, but my pulse is so slow I thought the watch had stopped.\nI checked the watch twice. It was keeping perfect time."
