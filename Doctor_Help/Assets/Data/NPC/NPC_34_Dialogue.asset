  m_Script: {fileID: 11500000, guid: 9a19a6ecd4ed2114c9ccb631dd1f32f4, type: 3}
  m_Name: NPC_34_Dialogue
  m_EditorClassIdentifier: Assembly-CSharp::DoctorHelp.NpcDialogueAsset
  content: "The clerk at the fish stall put a secret message in my lunch.\nI found a pale little thing wriggling afterwards, so you see what I mean.\nMy stomach's been knotting up ever since. Can a message do that?"
