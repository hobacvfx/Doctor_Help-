  m_Name: NPC_37_Dialogue
  m_EditorClassIdentifier: Assembly-CSharp::DoctorHelp.NpcDialogueAsset
  content: "I can't keep the days straight, and my fingertips have gone cold as brass.\nI asked my brother to check my pulse because I kept losing count.\nHe says there was nothing to count."
