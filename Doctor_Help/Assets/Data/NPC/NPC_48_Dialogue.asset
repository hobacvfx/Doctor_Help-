  m_Script: {fileID: 11500000, guid: 9a19a6ecd4ed2114c9ccb631dd1f32f4, type: 3}
  m_Name: NPC_48_Dialogue
  m_EditorClassIdentifier: Assembly-CSharp::DoctorHelp.NpcDialogueAsset
  content: "I spent two nights at a lodging house and shared their supper.\nSince then I've had stomach cramps and seen something thin moving in the basin.\nThe landlord said he'd never had a complaint. I suspect people just leave."
