  m_Script: {fileID: 11500000, guid: 9a19a6ecd4ed2114c9ccb631dd1f32f4, type: 3}
  m_Name: NPC_93_Dialogue
  m_EditorClassIdentifier: Assembly-CSharp::DoctorHelp.NpcDialogueAsset
  content: "Morning, doctor. I'm flushed and can't get my breath.\nMy heart's racing, and my elbow hurts where I caught it on the stair rail.\nPerhaps I hurried because something was following me up the stairs."
